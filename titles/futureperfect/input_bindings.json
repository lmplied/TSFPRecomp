{
  "version": 1,
  "pad_api": "sdl",
  "labels": {
    "a": "Activate / select",
    "b": "Melee / back",
    "x": "Reload",
    "y": "Menu option",
    "start": "Pause",
    "back": "Scores",
    "ltrigger": "Throw grenade",
    "rtrigger": "Fire",
    "dpad_up": "Zoom in",
    "dpad_down": "Zoom out",
    "dpad_left": "Previous weapon",
    "dpad_right": "Next weapon",
    "lstick_up": "Move forward",
    "lstick_down": "Move back",
    "lstick_left": "Step left",
    "lstick_right": "Step right",
    "lthumb": "Crouch",
    "rstick_up": "Look up",
    "rstick_down": "Look down",
    "rstick_left": "Turn left",
    "rstick_right": "Turn right",
    "rthumb": "Aim"
  },
  "controllers": [
    {
      "port": 1,
      "device": "gamepad:0",
      "deadzone": 7849,
      "mouse_sensitivity": 1.5,
      "mouse_deadzone": 12450,
      "mouse_exponent": 0.7,
      "mouse_y_scale": 1.0,
      "mouse_invert_y": false,
      "mouse_zoom_match": true,
      "mouse_window_ms": 16,
      "hold": ["rthumb"],
      "bindings": {
        "a": ["pad:a", "key:E", "key:SPACE", "key:RETURN"],
        "b": ["pad:b", "key:F", "key:BACK"],
        "x": ["pad:x", "key:R"],
        "y": ["pad:y", "key:V"],
        "black": ["pad:lshoulder"],
        "white": ["pad:rshoulder"],
        "start": ["pad:start", "key:ESCAPE"],
        "back": ["pad:back", "key:TAB"],
        "ltrigger": ["pad:lt", "key:G", "mouse:middle"],
        "rtrigger": ["pad:rt", "mouse:left"],
        "dpad_up": ["pad:dpad_up", "key:UP", "mouse:x2"],
        "dpad_down": ["pad:dpad_down", "key:DOWN", "mouse:x1"],
        "dpad_left": ["pad:dpad_left", "key:LEFT", "key:Q", "mouse:wheel_up"],
        "dpad_right": ["pad:dpad_right", "key:RIGHT", "mouse:wheel_down"],
        "lstick_up": ["pad:ly+", "key:W"],
        "lstick_down": ["pad:ly-", "key:S"],
        "lstick_left": ["pad:lx-", "key:A"],
        "lstick_right": ["pad:lx+", "key:D"],
        "lthumb": ["pad:lthumb", "key:C", "key:LCTRL"],
        "rstick_up": ["pad:ry+", "mouse:y+"],
        "rstick_down": ["pad:ry-", "mouse:y-"],
        "rstick_left": ["pad:rx-", "mouse:x-"],
        "rstick_right": ["pad:rx+", "mouse:x+"],
        "rthumb": ["pad:rthumb", "mouse:right"]
      }
    }
  ]
}
